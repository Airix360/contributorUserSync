  *
  * Default plugin settings. Defaults are deliberately safe: link existing
  * users only, sync verified ORCID, never auto-create users or overwrite
  * an existing contributor ORCID.
  -->
<plugin_settings>
	<!-- General -->
	<setting type="bool">
		<name>syncEnabled</name>
		<value>false</value>
	</setting>

	<!-- Sync behaviour: nothing | link | invite | create -->
	<setting type="string">
		<name>syncMode</name>
		<value>link</value>
	</setting>

	<!-- ORCID auto-sync -->
	<setting type="bool">
		<name>orcidAutoSync</name>
		<value>true</value>
	</setting>
	<setting type="bool">
		<name>orcidOverwrite</name>
		<value>false</value>
	</setting>
	<setting type="bool">
		<name>orcidAllowManual</name>
		<value>false</value>
	</setting>
	<!-- nothing | warn | request -->
	<setting type="string">
		<name>orcidNoVerifiedAction</name>
		<value>nothing</value>
	</setting>

	<!-- Existing users -->
	<setting type="bool">
		<name>updateContributorFromUser</name>
		<value>false</value>
	</setting>
	<setting type="bool">
		<name>updateUserFromContributor</name>
		<value>false</value>
	</setting>

	<!-- Contributor notifications / wizard -->
	<setting type="bool">
		<name>notifyAddedContributors</name>
		<value>false</value>
	</setting>
	<setting type="bool">
		<name>requireContributorCount</name>
		<value>false</value>
	</setting>
</plugin_settings>
