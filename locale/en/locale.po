msgid "plugins.generic.contributorUserSync.displayName"
msgstr "Contributor User Sync"

msgid "plugins.generic.contributorUserSync.description"
msgstr "Links submission contributors to OJS user accounts and reuses verified ORCID iDs from existing user profiles, reducing repeated ORCID prompts and improving author metadata quality."

# --- Settings: General
msgid "plugins.generic.contributorUserSync.settings.general"
msgstr "General"

msgid "plugins.generic.contributorUserSync.settings.syncEnabled"
msgstr "Enable Contributor User Sync"

# --- Settings: Sync behaviour
msgid "plugins.generic.contributorUserSync.settings.behaviour"
msgstr "Sync behaviour"

msgid "plugins.generic.contributorUserSync.settings.behaviour.desc"
msgstr "Choose what happens when a contributor is added or updated on a submission."

msgid "plugins.generic.contributorUserSync.settings.mode.nothing"
msgstr "Do nothing automatically"

msgid "plugins.generic.contributorUserSync.settings.mode.link"
msgstr "Link existing OJS users only (recommended)"

msgid "plugins.generic.contributorUserSync.settings.mode.invite"
msgstr "Invite missing contributors to create an account"

msgid "plugins.generic.contributorUserSync.settings.mode.create"
msgstr "Automatically create missing user accounts"

# --- Settings: ORCID auto-sync
msgid "plugins.generic.contributorUserSync.settings.orcid"
msgstr "ORCID auto-sync"

msgid "plugins.generic.contributorUserSync.settings.orcidAutoSync"
msgstr "Copy a verified ORCID iD from the matched user profile to the contributor"

msgid "plugins.generic.contributorUserSync.settings.orcidOverwrite"
msgstr "Overwrite an ORCID iD the contributor already has (off by default)"

msgid "plugins.generic.contributorUserSync.settings.orcidAllowManual"
msgstr "Also sync ORCID iDs that the user typed manually but never verified (off by default)"

msgid "plugins.generic.contributorUserSync.settings.orcidNoVerified.desc"
msgstr "When the matched user has no verified ORCID iD:"

msgid "plugins.generic.contributorUserSync.settings.orcidNoVerified.nothing"
msgstr "Do nothing"

msgid "plugins.generic.contributorUserSync.settings.orcidNoVerified.warn"
msgstr "Warn the editor in the sync report"

msgid "plugins.generic.contributorUserSync.settings.orcidNoVerified.request"
msgstr "Flag the contributor for an ORCID connection request"

# --- Settings: Contributor roles
msgid "plugins.generic.contributorUserSync.settings.roles"
msgstr "Contributor roles"

msgid "plugins.generic.contributorUserSync.settings.roles.desc"
msgstr "Select which contributor roles are eligible for syncing. Leave all unchecked to apply to every role."

# --- Settings: Existing users
msgid "plugins.generic.contributorUserSync.settings.existing"
msgstr "Existing users"

msgid "plugins.generic.contributorUserSync.settings.updateContributorFromUser"
msgstr "Fill empty contributor names from the matched user profile"

msgid "plugins.generic.contributorUserSync.settings.updateUserFromContributor"
msgstr "Update the user profile name from contributor metadata (off by default)"

# --- Settings: New users
msgid "plugins.generic.contributorUserSync.settings.new"
msgstr "New users"

msgid "plugins.generic.contributorUserSync.settings.new.desc"
msgstr "Newly created or invited accounts always get the Author role. Editor, Journal Manager, and Site Admin roles are never assigned automatically — there is no setting that grants them."

msgid "plugins.generic.contributorUserSync.settings.createUserAllowReviewer"
msgstr "Also grant the Reviewer role to newly created/invited accounts (in addition to Author)"

# --- Settings: Bulk sync
msgid "plugins.generic.contributorUserSync.settings.bulk"
msgstr "Bulk sync"

msgid "plugins.generic.contributorUserSync.settings.bulk.desc"
msgstr "Scan previous submissions in this journal and apply the sync rules above. Preview is a dry run that changes nothing."

msgid "plugins.generic.contributorUserSync.bulk.preview"
msgstr "Preview sync"

msgid "plugins.generic.contributorUserSync.bulk.run"
msgstr "Run sync"

msgid "plugins.generic.contributorUserSync.bulk.running"
msgstr "Working…"

msgid "plugins.generic.contributorUserSync.bulk.confirmRun"
msgstr "This will update contributor metadata across previous submissions in this journal. Continue?"

msgid "plugins.generic.contributorUserSync.bulk.export"
msgstr "Download report (CSV)"

msgid "plugins.generic.contributorUserSync.bulk.previewHeading"
msgstr "Preview results (no changes saved)"

msgid "plugins.generic.contributorUserSync.bulk.appliedHeading"
msgstr "Sync complete"

# --- Report counts
msgid "plugins.generic.contributorUserSync.report.scanned"
msgstr "Contributors scanned"

msgid "plugins.generic.contributorUserSync.report.matched"
msgstr "Existing users matched"

msgid "plugins.generic.contributorUserSync.report.created"
msgstr "New users created"

msgid "plugins.generic.contributorUserSync.report.invited"
msgstr "Invitations sent"

msgid "plugins.generic.contributorUserSync.report.orcidSynced"
msgstr "ORCID iDs synced"

msgid "plugins.generic.contributorUserSync.report.skippedNoEmail"
msgstr "Skipped — no email"

msgid "plugins.generic.contributorUserSync.report.skippedNoUser"
msgstr "Skipped — no matching user"

msgid "plugins.generic.contributorUserSync.report.skippedNoVerifiedOrcid"
msgstr "Skipped — no verified ORCID"

msgid "plugins.generic.contributorUserSync.report.errors"
msgstr "Errors"

msgid "plugins.generic.contributorUserSync.report.outcome"
msgstr "Outcome"

msgid "plugins.generic.contributorUserSync.report.submissionId"
msgstr "Submission ID"

# --- Outcome labels (editor-facing feedback)
msgid "plugins.generic.contributorUserSync.outcome.matchedUser"
msgstr "Matched existing user"

msgid "plugins.generic.contributorUserSync.outcome.linked"
msgstr "Linked contributor to user"

msgid "plugins.generic.contributorUserSync.outcome.orcidSynced"
msgstr "ORCID synced from verified user profile"

msgid "plugins.generic.contributorUserSync.outcome.orcidSkippedExisting"
msgstr "Contributor already had an ORCID; skipped overwrite"

msgid "plugins.generic.contributorUserSync.outcome.orcidRequestSent"
msgstr "ORCID verification request emailed to contributor"

msgid "plugins.generic.contributorUserSync.outcome.userCreated"
msgstr "New user account created"

msgid "plugins.generic.contributorUserSync.outcome.invitationSent"
msgstr "Invitation sent"

msgid "plugins.generic.contributorUserSync.outcome.skippedNoEmail"
msgstr "Skipped because the contributor has no email"

msgid "plugins.generic.contributorUserSync.outcome.skippedNoUser"
msgstr "No matching OJS user found"

msgid "plugins.generic.contributorUserSync.outcome.skippedNoVerifiedOrcid"
msgstr "Matching user found but no verified ORCID connected"

msgid "plugins.generic.contributorUserSync.outcome.skippedIneligibleRole"
msgstr "Skipped because the contributor role is not eligible"

msgid "plugins.generic.contributorUserSync.outcome.error"
msgstr "Error"

msgid "plugins.generic.contributorUserSync.outcome.matchPendingConfirmation"
msgstr "Matched an existing user; awaiting their confirmation before any data is merged"

msgid "plugins.generic.contributorUserSync.outcome.skippedMatchDeclined"
msgstr "The matched user declined the match; nothing was merged"

msgid "plugins.generic.contributorUserSync.outcome.skippedDuplicateMatch"
msgstr "Skipped — this user is already matched to another contributor on this submission"

msgid "plugins.generic.contributorUserSync.outcome.linkCleared"
msgstr "Previous user link cleared because the contributor's email changed"

# --- Contributors-panel actions
msgid "plugins.generic.contributorUserSync.action.sync"
msgstr "Sync"

msgid "plugins.generic.contributorUserSync.action.invite"
msgstr "Invite"

msgid "plugins.generic.contributorUserSync.action.syncAll"
msgstr "Sync Contributors"

msgid "plugins.generic.contributorUserSync.action.error"
msgstr "The sync request failed. Check that you have journal-manager access."

# --- Contributor notifications / wizard settings
msgid "plugins.generic.contributorUserSync.settings.notify"
msgstr "Contributor notifications"

msgid "plugins.generic.contributorUserSync.settings.notify.desc"
msgstr "Email contributors when they are added to a submission, and optionally require the submitter to declare how many contributors they will add."

msgid "plugins.generic.contributorUserSync.settings.notifyAddedContributors"
msgstr "Notify contributors when added to a submission (with a decline link that removes them)"

msgid "plugins.generic.contributorUserSync.settings.requireContributorCount"
msgstr "Require the submitter to declare a contributor count and match it before submitting"

# --- Added-to-submission notification email
msgid "plugins.generic.contributorUserSync.notify.name"
msgstr "Contributor added to submission"

msgid "plugins.generic.contributorUserSync.notify.description"
msgstr "Sent to a contributor when they are added to a submission, offering confirm or decline."

msgid "plugins.generic.contributorUserSync.notify.subject"
msgstr "You were added as a contributor to \"{$title}\""

msgid "plugins.generic.contributorUserSync.notify.body"
msgstr ""
"<p>Dear {$name},</p>"
"<p>You have been listed as a contributor on the submission <strong>\"{$title}\"</strong> in {$journal}.</p>"
"<p>If this is correct, you can confirm here:</p>"
"<p><a href=\"{$confirmUrl}\">Confirm my contribution</a></p>"
"<p>If you should not be on this submission, you can decline and be removed from the contributor list:</p>"
"<p><a href=\"{$declineUrl}\">Decline and remove me</a></p>"

# --- Confirm / decline result page
msgid "plugins.generic.contributorUserSync.approval.title"
msgstr "Contribution status"

msgid "plugins.generic.contributorUserSync.approval.confirmed"
msgstr "Thank you — your contribution to this submission has been confirmed."

msgid "plugins.generic.contributorUserSync.approval.declined"
msgstr "You have been removed from the contributor list for this submission."

msgid "plugins.generic.contributorUserSync.approval.invalid"
msgstr "This link is invalid or has already been used."

msgid "plugins.generic.contributorUserSync.approval.matchConfirmed"
msgstr "Thank you — your account is now linked to that submission's contributor entry, and your profile data (including ORCID) may be used there."

msgid "plugins.generic.contributorUserSync.approval.matchDeclined"
msgstr "Thanks for letting us know. Your account has not been linked, and no data was merged."

# --- Match-confirmation email (existing-user email match)
msgid "plugins.generic.contributorUserSync.matchNotify.name"
msgstr "Contributor match confirmation"

msgid "plugins.generic.contributorUserSync.matchNotify.description"
msgstr "Sent to an existing user account whose email matched a contributor on someone else's submission, asking them to confirm before any data is merged."

msgid "plugins.generic.contributorUserSync.matchNotify.subject"
msgstr "Please confirm: were you added as a contributor to \"{$title}\"?"

msgid "plugins.generic.contributorUserSync.matchNotify.body"
msgstr ""
"<p>Dear {$name},</p>"
"<p>Your OJS account's email address matches a contributor listed on the submission <strong>\"{$title}\"</strong> in {$journal}. No information has been shared or changed yet.</p>"
"<p>If this is your submission and you'd like your account (including any verified ORCID iD) linked to it, please confirm:</p>"
"<p><a href=\"{$confirmUrl}\">Confirm — this is me</a></p>"
"<p>If you do not recognise this submission, please decline and nothing further will happen:</p>"
"<p><a href=\"{$declineUrl}\">Decline — this is not me</a></p>"

# --- Wizard contributor-count gate
msgid "plugins.generic.contributorUserSync.wizard.countMismatch"
msgstr "You declared {$expected} contributor(s) but the submission has {$actual}. Please add or remove contributors so the numbers match before submitting."

msgid "plugins.generic.contributorUserSync.wizard.countLabel"
msgstr "How many contributors will this submission have?"

# --- New-user account state
msgid "plugins.generic.contributorUserSync.user.awaitingSetup"
msgstr "Account created by Contributor User Sync; awaiting activation by the contributor."

# --- New-account email ('create' mode)
msgid "plugins.generic.contributorUserSync.user.newAccountMail.name"
msgstr "New contributor account created"

msgid "plugins.generic.contributorUserSync.user.newAccountMail.description"
msgstr "Sent to a contributor when 'create' mode auto-creates an OJS account for them, with a link to set their own password."

msgid "plugins.generic.contributorUserSync.user.newAccountMail.subject"
msgstr "An account was created for you at {$journal}"

msgid "plugins.generic.contributorUserSync.user.newAccountMail.body"
msgstr ""
"<p>Dear {$name},</p>"
"<p>Because you were listed as a contributor on a submission, an account was created for you at {$journal} (username: <strong>{$username}</strong>).</p>"
"<p>For security, no password was set on your behalf. Please use the link below to set your own password before signing in:</p>"
"<p><a href=\"{$resetUrl}\">Set my password</a></p>"
